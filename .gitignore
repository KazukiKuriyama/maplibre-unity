.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Crashlytics
crashlytics-build.properties

# Code coverage
/[Cc]ode[Cc]overage/

# APE
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# TextMeshPro Essential Resources (auto-imported on first editor load — see TMPEssentialsCheck.cs)
/[Aa]ssets/TextMesh Pro/
/[Aa]ssets/TextMesh Pro.meta
Assets/Screenshots
Assets/Screenshots.meta

# Symbol-font assets generated from license-restricted system fonts (Hiragino,
# Yu Gothic, etc.). The TMP SDF atlas bakes glyph imagery from the source font
# and cannot be redistributed.
/[Aa]ssets/MapLibreUnity/Fonts/

# UPM サンプルのインポート展開先 — 正本は Packages/com.kazukikuriyama.maplibre-unity/Samples~/
# Package Manager の "Import Sample" で生成される複製なので tracked にしない。
/[Aa]ssets/[Ss]amples/
/[Aa]ssets/[Ss]amples.meta
/[Aa]ssets/MapLibreUnity/Samples/
/[Aa]ssets/MapLibreUnity/Samples.meta
/[Aa]ssets/MapLibreUnity.meta

# Test Runner scratch scenes — Unity creates `Assets/InitTestScene{guid}.unity`
# at PlayMode test startup and is supposed to remove it on exit. When a run
# is cancelled (kill signal, editor crash) the file stays around; ignoring
# it avoids accidentally committing scratch state.
/[Aa]ssets/InitTestScene*.unity
/[Aa]ssets/InitTestScene*.unity.meta

# Crash recovery scenes — Unity drops untitled scene snapshots into
# `Assets/_Recovery/` after a crash and prompts to recover on next launch.
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# AI agent local config / state
.claude/
.codex/
.cursor/
.mcp.json
