{
    "version": 8,
    "name": "Circle Layer Demo",
    "center": [139.7670, 35.6814],
    "zoom": 9,
    "sources": {
        "openmaptiles": {
            "type": "vector",
            "url": "https://tiles.openfreemap.org/planet",
            "attribution": "© OpenMapTiles © OpenStreetMap contributors"
        }
    },
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "#f0ede8"
            }
        },
        {
            "id": "water",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "water",
            "paint": {
                "fill-color": "#a0c8f0",
                "fill-opacity": 1.0
            }
        },
        {
            "id": "landcover",
            "type": "fill",
            "source": "openmaptiles",
            "source-layer": "landcover",
            "paint": {
                "fill-color": "#c8e6c0",
                "fill-opacity": 0.4
            }
        },
        {
            "id": "road",
            "type": "line",
            "source": "openmaptiles",
            "source-layer": "transportation",
            "paint": {
                "line-color": "#d0d0d0",
                "line-width": 1.5,
                "line-opacity": 0.8
            }
        },
        {
            "id": "poi-circle",
            "type": "circle",
            "source": "openmaptiles",
            "source-layer": "poi",
            "paint": {
                "circle-radius": ["interpolate", ["linear"], ["zoom"], 10, 4, 16, 10],
                "circle-color": "#ff4444",
                "circle-opacity": 0.7,
                "circle-stroke-width": 1.5,
                "circle-stroke-color": "#ffffff",
                "circle-stroke-opacity": 1.0
            }
        },
        {
            "id": "mountain-peak-circle",
            "type": "circle",
            "source": "openmaptiles",
            "source-layer": "mountain_peak",
            "paint": {
                "circle-radius": 8,
                "circle-color": "#8B4513",
                "circle-opacity": 0.8,
                "circle-stroke-width": 1,
                "circle-stroke-color": "#ffffff"
            }
        }
    ]
}
