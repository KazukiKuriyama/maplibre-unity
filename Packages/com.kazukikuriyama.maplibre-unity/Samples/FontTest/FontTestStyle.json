{
    "version": 8,
    "name": "Font Test - Japanese Labels",
    "center": [139.7670, 35.6814],
    "zoom": 3,
    "sources": {
        "demotiles": {
            "type": "vector",
            "url": "https://demotiles.maplibre.org/tiles/tiles.json"
        }
    },
    "layers": [
        {
            "id": "background",
            "type": "background",
            "paint": {
                "background-color": "#aad3df"
            }
        },
        {
            "id": "countries-fill",
            "type": "fill",
            "source": "demotiles",
            "source-layer": "countries",
            "paint": {
                "fill-color": "#f2efe9"
            }
        },
        {
            "id": "countries-boundary",
            "type": "line",
            "source": "demotiles",
            "source-layer": "countries",
            "paint": {
                "line-color": "#ccc0b0",
                "line-width": 1
            }
        },
        {
            "id": "country-labels",
            "type": "symbol",
            "source": "demotiles",
            "source-layer": "centroids",
            "layout": {
                "text-field": "{NAME}",
                "text-size": 100
            },
            "paint": {
                "text-color": "#1a1a1a",
                "text-halo-color": "rgba(255, 255, 255, 0.9)",
                "text-halo-width": 2
            }
        },
        {
            "id": "city-labels",
            "type": "symbol",
            "source": "demotiles",
            "source-layer": "place",
            "filter": ["==", "class", "city"],
            "layout": {
                "text-field": "{name}",
                "text-size": 80
            },
            "paint": {
                "text-color": "#222222",
                "text-halo-color": "rgba(255, 255, 255, 0.85)",
                "text-halo-width": 2
            }
        },
        {
            "id": "town-labels",
            "type": "symbol",
            "source": "demotiles",
            "source-layer": "place",
            "filter": ["==", "class", "town"],
            "layout": {
                "text-field": "{name}",
                "text-size": 60
            },
            "paint": {
                "text-color": "#444444",
                "text-halo-color": "rgba(255, 255, 255, 0.8)",
                "text-halo-width": 1.5
            }
        }
    ]
}
