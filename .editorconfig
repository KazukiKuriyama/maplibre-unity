root = true

[*.cs]
# Styles
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_style.pascal_case.capitalization = pascal_case

# 1. Constants: PascalCase (most specific — evaluated first)
dotnet_naming_rule.constant_field_rule.symbols = constant_field
dotnet_naming_rule.constant_field_rule.style = pascal_case
dotnet_naming_rule.constant_field_rule.severity = warning

dotnet_naming_symbols.constant_field.applicable_kinds = field
dotnet_naming_symbols.constant_field.applicable_accessibilities = private
dotnet_naming_symbols.constant_field.required_modifiers = const

# 2. Static readonly fields: PascalCase
dotnet_naming_rule.static_readonly_field_rule.symbols = static_readonly_field
dotnet_naming_rule.static_readonly_field_rule.style = pascal_case
dotnet_naming_rule.static_readonly_field_rule.severity = warning

dotnet_naming_symbols.static_readonly_field.applicable_kinds = field
dotnet_naming_symbols.static_readonly_field.applicable_accessibilities = private
dotnet_naming_symbols.static_readonly_field.required_modifiers = static,readonly

# 3. Private instance fields: _camelCase (least specific — evaluated last)
dotnet_naming_rule.private_field_rule.symbols = private_field
dotnet_naming_rule.private_field_rule.style = underscore_camel_case
dotnet_naming_rule.private_field_rule.severity = warning

dotnet_naming_symbols.private_field.applicable_kinds = field
dotnet_naming_symbols.private_field.applicable_accessibilities = private
